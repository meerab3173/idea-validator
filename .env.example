# Copy to .env for docker-compose. NEVER commit .env. In Kubernetes these are Secrets.
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-long-random-string
# Hosted LLM (Groq / OpenRouter / any OpenAI-compatible). Key only goes to the tools service.
LLM_UPSTREAM=https://api.groq.com/openai/v1
LLM_UPSTREAM_KEY=
LLM_MODEL=llama-3.1-8b-instant
GITHUB_TOKEN=
REDDIT_TOKEN=
